sudo lsof -iTCP -sTCP:LISTEN -P -n | awk 'NR>1 {split($9,a,":"); print $1, a[length(a)]}' | sort -u | while read proc port; do if [[ "$proc" == "docker-pr" ]]; then cname=$(docker ps --format '{{.Names}} {{.Ports}}' | awk -v p=":$port->" '$0 ~ p {print $1; exit}'); if [ -n "$cname" ]; then echo "$port $cname (docker)"; else echo "$port $proc"; fi; else echo "$port $proc"; fi; done | sort -n -k1,1:::show taken up ports
