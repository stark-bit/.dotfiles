## brew install git-delta
[include]
   path = ./.gitconfig_priv

[core]
  pager = delta
	autocrlf = false

[interactive]
  diffFilter = delta --color-only

[delta]
  navigate = true    # use n and N to move between diff sections
  side-by-side = true
  line-numbers = true
  dark = true
  file-style = "#000000 #ffffff"

    # delta detects terminal colors automatically; set one of these to disable auto-detection
    # dark = true
    # light = true

[pager]
  blame  = delta
  diff   = delta
  reflog = delta
  show   = delta
  fugitive   = delta
[merge]
    conflictstyle = zdiff3

## difftastic (opt-in, does not affect default delta diff)
[difftool "difftastic"]
  cmd = difft "$LOCAL" "$REMOTE"
[difftool]
  prompt = false

[alias]
  la = "!git config -l | grep alias | cut -c 7-" # List all active aliases
  l1 = "!git log --pretty=format:'%C(yellow)%h%Cred%d %Creset%s%Cgreen [%an]%C(dim) %ad%Creset' --decorate --date=format:'%Y-%m-%d %H:%M:%S %z'"
  l2 = "!git log --pretty=format:'%C(yellow)%h%Cred%d %Creset%s%Cgreen [%ad]%C(dim) %ad%Creset' --decorate --date=format:'%Y-%m-%d %H:%M:%S %z' --numstat"
  l3 = log --graph --abbrev-commit --decorate --all --format=format:'%C(bold blue)%h%C(reset) - %C(dim white)%an%C(reset) %C(bold yellow)%d%C(reset)%n''%C(white)%s%C(reset)' --date=short
  unstage = reset --soft HEAD^
  # difftastic opt-in (delta stays default for plain diff/show/log)
  dft  = "!f() { DFT_COLOR=always GIT_EXTERNAL_DIFF=difft git diff \"$@\" | less -R; }; f"
  dfts = "!f() { DFT_COLOR=always GIT_EXTERNAL_DIFF=difft git show --ext-diff \"$@\" | less -R; }; f"
  dftl = "!f() { DFT_COLOR=always GIT_EXTERNAL_DIFF=difft git log -p --ext-diff \"$@\" | less -R; }; f"

