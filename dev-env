#!/usr/bin/env bash

# env checks
if [ -z "$XDG_CONFIG_HOME" ]; then
    echo "no xdg config hom"
    echo "using ~/.config"
    XDG_CONFIG_HOME=$HOME/.config
fi

if [ -z "$DEV_ENV" ]; then
    echo "env var DEV_ENV needs to be present"
    exit 1
fi

# flags
force="0"

while [[ $# -gt 0 ]]; do
    case "$1" in
        -f) force="1" ;;
        *) echo "Unknown argument: $1"; exit 1 ;;
    esac
    shift
done

# safe by default: dry_run + warn unless -f
if [[ $force == "0" ]]; then
    dry_run="1"
    warn_only="1"
else
    dry_run="0"
    warn_only="0"
fi

# shared helpers
source "$DEV_ENV/lib/log.sh"
source "$DEV_ENV/lib/detect_os_and_run"

# functions
update_files() {
    log "copying over files from: $1"
    pushd $1 &> /dev/null
    (
        configs=`find . -mindepth 1 -maxdepth 1 -type d`
        for c in $configs; do
            directory=${2%/}/${c#./}

            if [[ $warn_only == "1" ]]; then
                # walk files in source dir, warn_size against target counterparts
                find ./$c -type f | while read -r f; do
                    src_file="$1/${f#./}"
                    tgt_file="${2%/}/${f#./}"
                    warn_size "$src_file" "$tgt_file"
                done
            fi

            log "    removing: rm -rf $directory"
            if [[ $dry_run == "0" ]]; then
                rm -rf $directory
            fi

            log "    copying env: cp $c $2"
            if [[ $dry_run == "0" ]]; then
                cp -r ./$c $2
            fi
        done

    )
    popd &> /dev/null
}

copy() {
    log "removing: $2"
    if [[ $dry_run == "1" ]]; then
        warn_size "$1" "$2"
    fi
    if [[ $dry_run == "0" ]]; then
        rm $2
    fi
    log "copying: $1 to $2"
    if [[ $dry_run == "0" ]]; then
        cp $1 $2
    fi
}

link() {
    log "symlinking: $1 -> $2"
    if [[ $dry_run == "0" ]]; then
        ln -sf "$1" "$2"
    fi
}

mac() {
  link $DEV_ENV/env/.cl-mac-commands $HOME/.cl-commands
}
fedora() {
  link $DEV_ENV/env/.cl-fed-commands $HOME/.cl-commands
}
debian() {
  link $DEV_ENV/env/.cl-deb-commands $HOME/.cl-commands
}
fallback() {
    echo "OS not supported. Exiting."
    exit 1
}

# execution
log "env: $DEV_ENV"

update_files $DEV_ENV/env/.config $XDG_CONFIG_HOME
update_files $DEV_ENV/env/.local $HOME/.local

copy $DEV_ENV/env/.zsh_profile $HOME/.zsh_profile
copy $DEV_ENV/env/.zshrc $HOME/.zshrc
copy $DEV_ENV/env/.vimrc $HOME/.vimrc
copy $DEV_ENV/env/.gitconfig $HOME/.gitconfig
copy $DEV_ENV/env/.tmux.conf $HOME/.tmux.conf

copy $DEV_ENV/dev-env $HOME/.local/scripts/dev-env
copy $DEV_ENV/cl $HOME/.local/scripts/cl

detect_os_and_run \
  --mac-func mac \
  --fedora-func fedora \
  --debian-func debian \
  --fallback-func fallback
