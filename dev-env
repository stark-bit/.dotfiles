#!/usr/bin/env bash

# env checks
if [ -z "$XDG_CONFIG_HOME" ]; then
    echo "no xdg config hom"
    echo "using ~/.config"
    XDG_CONFIG_HOME=$HOME/.config
fi

if [ -z "$DEV_ENV" ]; then
    echo "env var DEV_ENV needs to be present"
    exit 1
fi

# flags
force="0"
direction="push"
diff_mode="0"

while [[ $# -gt 0 ]]; do
    case "$1" in
        pull) direction="pull" ;;
        -f) force="1" ;;
        --diff) diff_mode="1" ;;
        *) echo "Unknown argument: $1"; exit 1 ;;
    esac
    shift
done

# safe by default: dry_run + warn unless -f
if [[ $force == "0" ]]; then
    dry_run="1"
    warn_only="1"
else
    dry_run="0"
    warn_only="0"
fi

# shared helpers
source "$DEV_ENV/lib/log.sh"
source "$DEV_ENV/lib/detect_os_and_run"

# diff mode: show diffs only, then exit
if [[ $diff_mode == "1" ]]; then
    diff_files() {
        local repo_dir="$1"
        local home_dir="$2"

        pushd "$repo_dir" &> /dev/null

        # iterate top-level subdirs (mirrors update_files logic)
        local configs=$(find . -mindepth 1 -maxdepth 1 -type d)
        for c in $configs; do
            local repo_path="${repo_dir%/}/${c#./}"
            local home_path="${home_dir%/}/${c#./}"

            if [[ ! -d "$home_path" ]]; then
                continue
            fi

            # content diffs for files tracked in repo
            find ./$c -type f | while read -r f; do
                local rel="${f#./$c/}"
                local repo_file="${repo_path%/}/$rel"
                local home_file="${home_path%/}/$rel"

                # detect files that exist in repo but not in home
                if [[ ! -f "$home_file" ]]; then
                    local short="~${home_file#$HOME}"
                    if [[ $direction == "pull" ]]; then
                        echo "SKIP (no home file to pull): $short"
                    else
                        echo "NEW (will be CREATED on push): $short"
                    fi
                    continue
                fi

                if [[ $direction == "pull" ]]; then
                    show_diff "$home_file" "$repo_file"
                else
                    show_diff "$repo_file" "$home_file"
                fi
            done

            # orphan detection: home files that don't exist in repo
            # only relevant for push (push does rm -rf + cp -r per subdir)
            if [[ $direction == "push" ]]; then
                pushd "$home_path" &> /dev/null
                find . -type f -not -path "*/node_modules/*" | while read -r f; do
                    local rel="${f#./}"
                    local repo_file="${repo_path%/}/$rel"
                    local base=$(basename "$rel")
                    if [[ $base == "dev-env" || $base == "cl" ]]; then
                        continue
                    fi
                    if [[ ! -f "$repo_file" ]]; then
                        local home_file="${home_path%/}/$rel"
                        local short="~${home_file#$HOME}"
                        echo "ORPHAN (will be DELETED on push): $short"
                    fi
                done
                popd &> /dev/null
            fi
        done

        popd &> /dev/null
    }

    diff_file() {
        local repo_file="$1"
        local home_file="$2"

        if [[ $direction == "pull" ]]; then
            if [[ ! -f "$home_file" ]]; then
                local short="~${home_file#$HOME}"
                echo "SKIP (no home file to pull): $short"
                return
            fi
            show_diff "$home_file" "$repo_file"
        else
            if [[ ! -f "$home_file" ]]; then
                local short="~${home_file#$HOME}"
                echo "NEW (will be CREATED on push): $short"
                return
            fi
            show_diff "$repo_file" "$home_file"
        fi
    }

    diff_files "$DEV_ENV/env/.config" "$XDG_CONFIG_HOME"
    diff_files "$DEV_ENV/env/.local" "$HOME/.local"

    diff_file "$DEV_ENV/env/.zsh_profile" "$HOME/.zsh_profile"
    diff_file "$DEV_ENV/env/.zshrc" "$HOME/.zshrc"
    diff_file "$DEV_ENV/env/.vimrc" "$HOME/.vimrc"
    diff_file "$DEV_ENV/env/.gitconfig" "$HOME/.gitconfig"
    diff_file "$DEV_ENV/env/.tmux.conf" "$HOME/.tmux.conf"

    exit 0
fi

# functions
# $1 = repo dir, $2 = home dir (always in this order)
update_files() {
    local repo_dir="$1"
    local home_dir="$2"

    if [[ $direction == "pull" ]]; then
        log "pulling files from: $home_dir -> $repo_dir"
    else
        log "pushing files from: $repo_dir -> $home_dir"
    fi

    # always iterate repo dir to determine which dirs to sync
    pushd $repo_dir &> /dev/null
    (
        configs=`find . -mindepth 1 -maxdepth 1 -type d`
        for c in $configs; do
            local repo_path="${repo_dir%/}/${c#./}"
            local home_path="${home_dir%/}/${c#./}"

            if [[ $direction == "pull" ]]; then
                if [[ ! -d "$home_path" ]]; then
                    log "    SKIP: $home_path does not exist"
                    continue
                fi

                # pull: copy only files that exist in repo, not the whole home dir
                find ./$c -type f | while read -r f; do
                    local rel="${f#./$c/}"
                    local src_file="${home_path%/}/$rel"
                    local tgt_file="${repo_path%/}/$rel"

                    if [[ ! -f "$src_file" ]]; then
                        log "    SKIP: $src_file does not exist"
                        continue
                    fi

                    if [[ $warn_only == "1" ]]; then
                        warn_size "$src_file" "$tgt_file"
                    fi

                    log "    removing: $tgt_file"
                    if [[ $dry_run == "0" ]]; then
                        rm -f "$tgt_file"
                    fi

                    log "    copying: $src_file -> $tgt_file"
                    if [[ $dry_run == "0" ]]; then
                        cp "$src_file" "$tgt_file"
                    fi
                done
            else
                if [[ $warn_only == "1" ]]; then
                    find ./$c -type f | while read -r f; do
                        local src_file="${repo_path%/}/${f#./$c/}"
                        local tgt_file="${home_path%/}/${f#./$c/}"
                        warn_size "$src_file" "$tgt_file"
                    done
                fi

                log "    removing: rm -rf $home_path"
                if [[ $dry_run == "0" ]]; then
                    rm -rf "$home_path"
                fi

                log "    copying: cp -r $repo_path -> $home_path"
                if [[ $dry_run == "0" ]]; then
                    cp -r "$repo_path" "$home_path"
                fi
            fi
        done

    )
    popd &> /dev/null
}

# $1 = repo file, $2 = home file (always in this order)
copy() {
    local repo_file="$1"
    local home_file="$2"

    if [[ $direction == "pull" ]]; then
        local src="$home_file"
        local tgt="$repo_file"
    else
        local src="$repo_file"
        local tgt="$home_file"
    fi

    if [[ ! -f "$src" ]]; then
        log "SKIP: source $src does not exist"
        return
    fi

    if [[ $dry_run == "1" ]]; then
        warn_size "$src" "$tgt"
    fi

    log "removing: $tgt"
    if [[ $dry_run == "0" ]]; then
        rm -f "$tgt"
    fi

    log "copying: $src -> $tgt"
    if [[ $dry_run == "0" ]]; then
        cp "$src" "$tgt"
    fi
}

link() {
    log "symlinking: $1 -> $2"
    if [[ $dry_run == "0" ]]; then
        ln -sf "$1" "$2"
    fi
}

mac() {
  link $DEV_ENV/env/.cl-mac-commands $HOME/.cl-commands
}
fedora() {
  link $DEV_ENV/env/.cl-fed-commands $HOME/.cl-commands
}
debian() {
  link $DEV_ENV/env/.cl-deb-commands $HOME/.cl-commands
}
fallback() {
    echo "OS not supported. Exiting."
    exit 1
}

# execution
log "env: $DEV_ENV"
log "direction: $direction"

update_files $DEV_ENV/env/.config $XDG_CONFIG_HOME
update_files $DEV_ENV/env/.local $HOME/.local

copy $DEV_ENV/env/.zsh_profile $HOME/.zsh_profile
copy $DEV_ENV/env/.zshrc $HOME/.zshrc
copy $DEV_ENV/env/.vimrc $HOME/.vimrc
copy $DEV_ENV/env/.gitconfig $HOME/.gitconfig
copy $DEV_ENV/env/.tmux.conf $HOME/.tmux.conf

if [[ $direction == "push" ]]; then
    copy $DEV_ENV/dev-env $HOME/.local/scripts/dev-env
    copy $DEV_ENV/cl $HOME/.local/scripts/cl

    detect_os_and_run \
      --mac-func mac \
      --fedora-func fedora \
      --debian-func debian \
      --fallback-func fallback
else
    log "skipping dev-env and cl self-copy (only relevant for push)"
    log "skipping .cl-commands (already symlinked to repo)"
fi
