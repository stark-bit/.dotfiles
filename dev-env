#!/usr/bin/env bash

# env checks
if [ -z "$XDG_CONFIG_HOME" ]; then
    echo "no xdg config hom"
    echo "using ~/.config"
    XDG_CONFIG_HOME=$HOME/.config
fi

if [ -z "$DEV_ENV" ]; then
    echo "env var DEV_ENV needs to be present"
    exit 1
fi

# flags
force="0"
direction="push"
diff_mode="0"

while [[ $# -gt 0 ]]; do
    case "$1" in
        pull) direction="pull" ;;
        -f) force="1" ;;
        --diff) diff_mode="1" ;;
        *) echo "Unknown argument: $1"; exit 1 ;;
    esac
    shift
done

# safe by default: dry_run + warn unless -f
if [[ $force == "0" ]]; then
    dry_run="1"
    warn_only="1"
else
    dry_run="0"
    warn_only="0"
fi

# shared helpers
source "$DEV_ENV/lib/log.sh"
source "$DEV_ENV/lib/detect_os_and_run"

# diff mode: show summary and diffs
if [[ $diff_mode == "1" ]]; then
    summary_mode="1"
    summary_paths=()
    summary_added=()
    summary_removed=()
    summary_kinds=()
    summary_diffs=()

    tmpdir=$(mktemp -d)
    trap 'rm -rf "$tmpdir"' EXIT
    n=0

    RESET=$'\e[0m'; BOLD=$'\e[1m'; DIM=$'\e[2m'
    CYAN=$'\e[38;5;110m'; GREEN=$'\e[38;5;158m'; RED=$'\e[38;5;203m'
    YELLOW=$'\e[38;5;220m'; GREY=$'\e[38;5;245m'; WHITE=$'\e[38;5;188m'
    BLUE=$'\e[38;5;111m'

    short_path() {
        local path="$1"
        if [[ "$path" == "$HOME"/* ]]; then
            echo "~${path#$HOME}"
        else
            echo "${path#$DEV_ENV/}"
        fi
    }

    record_diff() {
        local src="$1"
        local tgt="$2"
        local d stats
        d=$(diff -U0 "$tgt" "$src")
        stats=$(awk '
            /^\+[^+]/ { added++ }
            /^-[^-]/ { removed++ }
            END { print added + 0, removed + 0 }
        ' <<< "$d")
        n=$((n + 1))
        printf '%s\n' "$d" > "$tmpdir/diff.$n"
        summary_paths+=("$(short_path "$tgt")")
        summary_added+=("${stats%% *}")
        summary_removed+=("${stats##* }")
        summary_kinds+=("changed")
        summary_diffs+=("$tmpdir/diff.$n")
    }

    record_new() {
        local src="$1"
        local tgt="$2"
        summary_paths+=("$(short_path "$tgt")")
        summary_added+=("$(wc -l < "$src")")
        summary_removed+=("0")
        summary_kinds+=("new")
        summary_diffs+=("")
    }

    record_orphan() {
        local path="$1"
        summary_paths+=("$(short_path "$path")")
        summary_added+=("0")
        summary_removed+=("$(wc -l < "$path")")
        summary_kinds+=("orphan")
        summary_diffs+=("")
    }

    diff_files() {
        local repo_dir="$1"
        local home_dir="$2"

        pushd "$repo_dir" &> /dev/null
        local configs=$(find . -mindepth 1 -maxdepth 1 -type d)
        for c in $configs; do
            local repo_path="${repo_dir%/}/${c#./}"
            local home_path="${home_dir%/}/${c#./}"

            if [[ ! -d "$home_path" ]]; then
                continue
            fi

            # push: read via process substitution so arrays persist
            while read -r f; do
                local rel="${f#./$c/}"
                local repo_file="${repo_path%/}/$rel"
                local home_file="${home_path%/}/$rel"

                if [[ ! -f "$home_file" ]]; then
                    if [[ $direction == "pull" ]]; then
                        if [[ $summary_mode == "0" ]]; then
                            echo "SKIP (no home file to pull): ~${home_file#$HOME}"
                        fi
                    elif [[ $summary_mode == "1" ]]; then
                        record_new "$repo_file" "$home_file"
                    else
                        echo "NEW (will be CREATED on push): ~${home_file#$HOME}"
                    fi
                    continue
                fi

                if [[ $direction == "pull" ]]; then
                    show_diff "$home_file" "$repo_file"
                else
                    show_diff "$repo_file" "$home_file"
                fi
            done < <(find ./$c -type f)

            if [[ $direction == "push" ]]; then
                pushd "$home_path" &> /dev/null
                while read -r f; do
                    local rel="${f#./}"
                    local repo_file="${repo_path%/}/$rel"
                    local base=$(basename "$rel")
                    if [[ $base == "dev-env" || $base == "cl" ]]; then
                        continue
                    fi
                    if [[ ! -f "$repo_file" ]]; then
                        local home_file="${home_path%/}/$rel"
                        if [[ $summary_mode == "1" ]]; then
                            record_orphan "$home_file"
                        else
                            echo "ORPHAN (will be DELETED on push): ~${home_file#$HOME}"
                        fi
                    fi
                done < <(find . -type f -not -path "*/node_modules/*")
                popd &> /dev/null
            fi
        done
        popd &> /dev/null
    }

    diff_file() {
        local repo_file="$1"
        local home_file="$2"

        if [[ $direction == "pull" ]]; then
            if [[ ! -f "$home_file" ]]; then
                if [[ $summary_mode == "0" ]]; then
                    echo "SKIP (no home file to pull): ~${home_file#$HOME}"
                fi
                return
            fi
            show_diff "$home_file" "$repo_file"
        else
            if [[ ! -f "$home_file" ]]; then
                if [[ $summary_mode == "1" ]]; then
                    record_new "$repo_file" "$home_file"
                else
                    echo "NEW (will be CREATED on push): ~${home_file#$HOME}"
                fi
                return
            fi
            show_diff "$repo_file" "$home_file"
        fi
    }

    summary_mode="1"
    diff_files "$DEV_ENV/env/.config" "$XDG_CONFIG_HOME"
    diff_files "$DEV_ENV/env/.local" "$HOME/.local"
    diff_file "$DEV_ENV/env/.zsh_profile" "$HOME/.zsh_profile"
    diff_file "$DEV_ENV/env/.zshrc" "$HOME/.zshrc"
    diff_file "$DEV_ENV/env/.vimrc" "$HOME/.vimrc"
    diff_file "$DEV_ENV/env/.gitconfig" "$HOME/.gitconfig"
    diff_file "$DEV_ENV/env/.tmux.conf" "$HOME/.tmux.conf"

    # render -----------------------------------------------------------------

    total=${#summary_paths[@]}
    orphans=0; changed=0; new=0
    for k in "${summary_kinds[@]}"; do
        case "$k" in
            orphan) orphans=$((orphans + 1)) ;;
            changed) changed=$((changed + 1)) ;;
            new) new=$((new + 1)) ;;
        esac
    done

    echo ""
    echo "${BOLD}${CYAN}● dev-env${RESET} ${DIM}push preview (dry-run)${RESET}"
    echo "${DIM}─────────────────────────────────────────────────${RESET}"

    if [[ $total == 0 ]]; then
        echo ""
        echo "  ${GREEN}✓${RESET} everything in sync"
        echo ""
        exit 0
    fi

    maxpath=0
    for p in "${summary_paths[@]}"; do
        l=${#p}
        (( l > maxpath )) && maxpath=$l
    done
    (( maxpath < 20 )) && maxpath=20

    echo ""
    echo "  ${BOLD}${WHITE}summary${RESET} ${GREY}· ${total} files · ${changed} changed · ${new} new · ${orphans} orphan${RESET}"
    echo ""

    order=()
    for i in "${!summary_paths[@]}"; do [[ "${summary_kinds[$i]}" == changed ]] && order+=("$i"); done
    for i in "${!summary_paths[@]}"; do [[ "${summary_kinds[$i]}" == new     ]] && order+=("$i"); done
    for i in "${!summary_paths[@]}"; do [[ "${summary_kinds[$i]}" == orphan  ]] && order+=("$i"); done

    for i in "${order[@]}"; do
        k="${summary_kinds[$i]}"
        p="${summary_paths[$i]}"
        a="${summary_added[$i]}"; r="${summary_removed[$i]}"
        case "$k" in
            changed) tag="${YELLOW} ~ changed ${RESET}"; stat="${GREEN}+${a}${RESET} ${RED}−${r}${RESET}" ;;
            new)     tag="${GREEN} + new     ${RESET}"; stat="${GREEN}+${a}${RESET} ${RED}−0${RESET}" ;;
            orphan)  tag="${RED} ✗ orphan  ${RESET}"; stat="${RED}−${r} lines${RESET}" ;;
        esac
        printf '  %s %s%-*s%s  %s\n' "$tag" "${BOLD}" "$maxpath" "$p" "${RESET}" "$stat"
    done

    echo ""
    echo "${DIM}─────────────────────────────────────────────────${RESET}"

    for i in "${order[@]}"; do
        if [[ "${summary_kinds[$i]}" == "changed" ]]; then
            echo ""
            echo "${BOLD}${WHITE}${summary_paths[$i]}${RESET}"
            echo "${DIM}      ┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄┄${RESET}"
            while IFS= read -r line; do
                case "$line" in
                    ---*|+++*) ;;
                    @@*)  echo "  ${BLUE}${line}${RESET}" ;;
                    +*)   echo "  ${GREEN}${line}${RESET}" ;;
                    -*)   echo "  ${RED}${line}${RESET}" ;;
                    *)    echo "  ${DIM}${line}${RESET}" ;;
                esac
            done < "${summary_diffs[$i]}"
        fi
    done

    apply_hint="dev-env -f"
    if [[ $direction == "pull" ]]; then
        apply_hint="dev-env -f pull"
    fi
    echo ""
    if [[ $orphans -gt 0 ]]; then
        echo "  ${BOLD}${RED}⚠ ${orphans} orphan${RESET} ${DIM}— would be deleted on push; move them into env/ or remove them first${RESET}"
    fi
    echo "  ${DIM}apply with: ${apply_hint}${RESET}"
    echo ""

    exit 0
fi

# functions
# $1 = repo dir, $2 = home dir (always in this order)
update_files() {
    local repo_dir="$1"
    local home_dir="$2"

    if [[ $direction == "pull" ]]; then
        log "pulling files from: $home_dir -> $repo_dir"
    else
        log "pushing files from: $repo_dir -> $home_dir"
    fi

    # always iterate repo dir to determine which dirs to sync
    pushd $repo_dir &> /dev/null
    (
        configs=`find . -mindepth 1 -maxdepth 1 -type d`
        for c in $configs; do
            local repo_path="${repo_dir%/}/${c#./}"
            local home_path="${home_dir%/}/${c#./}"

            if [[ $direction == "pull" ]]; then
                if [[ ! -d "$home_path" ]]; then
                    log "    SKIP: $home_path does not exist"
                    continue
                fi

                # pull: copy only files that exist in repo, not the whole home dir
                find ./$c -type f | while read -r f; do
                    local rel="${f#./$c/}"
                    local src_file="${home_path%/}/$rel"
                    local tgt_file="${repo_path%/}/$rel"

                    if [[ ! -f "$src_file" ]]; then
                        log "    SKIP: $src_file does not exist"
                        continue
                    fi

                    if [[ $warn_only == "1" ]]; then
                        warn_size "$src_file" "$tgt_file"
                    fi

                    log "    removing: $tgt_file"
                    if [[ $dry_run == "0" ]]; then
                        rm -f "$tgt_file"
                    fi

                    log "    copying: $src_file -> $tgt_file"
                    if [[ $dry_run == "0" ]]; then
                        cp "$src_file" "$tgt_file"
                    fi
                done
            else
                if [[ $warn_only == "1" ]]; then
                    find ./$c -type f | while read -r f; do
                        local src_file="${repo_path%/}/${f#./$c/}"
                        local tgt_file="${home_path%/}/${f#./$c/}"
                        warn_size "$src_file" "$tgt_file"
                    done
                fi

                log "    removing: rm -rf $home_path"
                if [[ $dry_run == "0" ]]; then
                    rm -rf "$home_path"
                fi

                log "    copying: cp -r $repo_path -> $home_path"
                if [[ $dry_run == "0" ]]; then
                    cp -r "$repo_path" "$home_path"
                fi
            fi
        done

    )
    popd &> /dev/null
}

# $1 = repo file, $2 = home file (always in this order)
copy() {
    local repo_file="$1"
    local home_file="$2"

    if [[ $direction == "pull" ]]; then
        local src="$home_file"
        local tgt="$repo_file"
    else
        local src="$repo_file"
        local tgt="$home_file"
    fi

    if [[ ! -f "$src" ]]; then
        log "SKIP: source $src does not exist"
        return
    fi

    if [[ $dry_run == "1" ]]; then
        warn_size "$src" "$tgt"
    fi

    log "removing: $tgt"
    if [[ $dry_run == "0" ]]; then
        rm -f "$tgt"
    fi

    log "copying: $src -> $tgt"
    if [[ $dry_run == "0" ]]; then
        cp "$src" "$tgt"
    fi
}

link() {
    log "symlinking: $1 -> $2"
    if [[ $dry_run == "0" ]]; then
        ln -sf "$1" "$2"
    fi
}

mac() {
  link $DEV_ENV/env/.cl-mac-commands $HOME/.cl-commands
}
fedora() {
  link $DEV_ENV/env/.cl-fed-commands $HOME/.cl-commands
}
debian() {
  link $DEV_ENV/env/.cl-deb-commands $HOME/.cl-commands
}
fallback() {
    echo "OS not supported. Exiting."
    exit 1
}

# execution
log "env: $DEV_ENV"
log "direction: $direction"

update_files $DEV_ENV/env/.config $XDG_CONFIG_HOME
update_files $DEV_ENV/env/.local $HOME/.local

copy $DEV_ENV/env/.zsh_profile $HOME/.zsh_profile
copy $DEV_ENV/env/.zshrc $HOME/.zshrc
copy $DEV_ENV/env/.vimrc $HOME/.vimrc
copy $DEV_ENV/env/.gitconfig $HOME/.gitconfig
copy $DEV_ENV/env/.tmux.conf $HOME/.tmux.conf

if [[ $direction == "push" ]]; then
    copy $DEV_ENV/dev-env $HOME/.local/scripts/dev-env
    copy $DEV_ENV/cl $HOME/.local/scripts/cl

    detect_os_and_run \
      --mac-func mac \
      --fedora-func fedora \
      --debian-func debian \
      --fallback-func fallback
else
    log "skipping dev-env and cl self-copy (only relevant for push)"
    log "skipping .cl-commands (already symlinked to repo)"
fi
